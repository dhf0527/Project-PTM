  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC720\uB2DB\uB4E4\uC740 \uAC01\uC790 \uB2E4\uC591\uD55C \uD2B9\uC9D5\uACFC
    \uC7A5\uB2E8\uC810\uC744 \uC9C0\uB2C8\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC774\uB7EC\uD55C
    \uD2B9\uC9D5\uB4E4\uC744 \uC798 \uD65C\uC6A9\uD558\uB2E4\uBA74 \uB354 \uD6A8\uC728\uC801\uC73C\uB85C
    \uC804\uD22C\uB97C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC6B0\uC120
    \uC720\uB2DB \uC911\uC5D4 \uD2B9\uC815 \uD53C\uD574 \uC720\uD615\uC5D0 \uB300\uD574
    \uC800\uD56D\uD558\uAC70\uB098 \uCDE8\uC57D\uD55C \uC720\uB2DB\uB4E4\uC774 \uC788\uC2B5\uB2C8\uB2E4.\n\n-
    \uC720\uB2DB\uC774 \uC800\uD56D\uD558\uB294 \uC720\uD615\uC758 \uD53C\uD574\uB97C
    \uBC1B\uC744 \uACBD\uC6B0 \uD53C\uD574\uAC00 50% \uAC10\uC18C\uD569\uB2C8\uB2E4.\n-
    \uC720\uB2DB\uC774 \uCDE8\uC57D\uD55C \uC720\uD615\uC758 \uD53C\uD574\uB97C \uBC1B\uC744
    \uACBD\uC6B0 \uD53C\uD574\uAC00 50% \uC99D\uAC00\uD569\uB2C8\uB2E4.\n\n\uC608\uB97C
    \uB4E4\uC5B4 \uB098\uBB34 \uAC70\uC778\uC758 \uACBD\uC6B0 \uB9C8\uBC95 \uD53C\uD574\uC5D0
    \uC800\uD56D\uC744 \uC9C0\uB2C8\uACE0 \uD654\uC5FC \uD53C\uD574\uC5D0 \uCDE8\uC57D\uD558\uBBC0\uB85C
    \uBC14\uBC95\uC0AC\uC5D0\uAC8C \uC720\uB9AC\uD558\uACE0 \uB4DC\uB798\uACE4\uC5D0\uAC8C
    \uBD88\uB9AC\uD569\uB2C8\uB2E4."
