  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBC29\uC5B4\uB3C4\uB97C \uC9C0\uB2CC \uC720\uB2DB\uC740 \uC790\uC2E0\uC774
    \uACF5\uACA9\uC73C\uB85C \uBC1B\uB294 \uD53C\uD574\uB97C \uBC29\uC5B4\uB3C4 \uB9CC\uD07C
    \uAC10\uC18C\uC2DC\uD0B5\uB2C8\uB2E4. (1\uBCF4\uB2E4 \uB0AE\uC544\uC9C8 \uC218\uB294
    \uC5C6\uC2B5\uB2C8\uB2E4.)\n\n\uBC29\uC5B4\uB3C4\uAC00 5\uC778 \uC720\uB2DB\uC740
    20\uC758 \uD53C\uD574\uB97C \uC8FC\uB294 \uACF5\uACA9\uC744 \uBC1B\uC73C\uBA74
    15\uC758 \uD53C\uD574\uB97C \uBC1B\uACE0\n10\uC758 \uD53C\uD574\uB97C \uB450
    \uBC88 \uBC1B\uC744 \uACBD\uC6B0 5+5, 10\uC758 \uD53C\uD574\uB97C \uBC1B\uAC8C
    \uB429\uB2C8\uB2E4.\n\n\uC989, \uBC29\uC5B4\uB3C4\uAC00 \uB192\uC740 \uC720\uB2DB\uC5D0\uAC90
    \uC5EC\uB7EC \uBC88\uC758 \uB0AE\uC740 \uD53C\uD574\uBCF4\uB2E4 \uD55C \uBC88\uC758
    \uAC15\uD55C \uD53C\uD574\uAC00 \uB354 \uD6A8\uC728\uC801\uC785\uB2C8\uB2E4.\n\uB610\uB294
    \uAD00\uD1B5 \uD53C\uD574\uB97C \uC8FC\uC5B4 \uBC29\uC5B4\uB3C4\uB97C \uBB34\uC2DC\uD558\uACE0
    \uACF5\uACA9\uD558\uB294 \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC785\uB2C8\uB2E4.\n\n\uC608\uB97C
    \uB4E4\uC5B4 \uBC29\uC5B4\uB3C4\uAC00 \uB192\uC740 \uACE8\uB818\uC758 \uACBD\uC6B0
    \uBE60\uB978 \uACF5\uACA9\uC18D\uB3C4\uB85C \uACF5\uACA9\uD558\uB294\uB3C4\uC801\uC758
    \uACF5\uACA9\uC5D0 \uAC70\uC758 \uD53C\uD574\uB97C \uC785\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uD558\uC9C0\uB9CC
    \uBBF8\uB178\uD0C0\uC6B0\uB85C\uC2A4\uC758 \uAC15\uB825\uD55C \uACF5\uACA9\uC740
    \uACE8\uB818\uC5D0\uAC8C\uB3C4 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
