  mealDescription: "\uBCF4\uC2A4\uB97C \uC81C\uC678\uD55C \uBAA8\uB4E0 \uC801\uC758
    \uC0DD\uC131 \uC218 \uB450 \uBC30, \uC601\uC6C5\uC758 \uC0DD\uBA85\uB825, \uACF5\uACA9\uB825,
    \uBC29\uC5B4\uB3C4, \uACF5\uACA9 \uC18D\uB3C4 \uB450\uBC30\uB85C \uC99D\uAC00"
  mealFlavorText: "\uC911\uC559 \uC655\uAD6D\uC758 \uC655\uC2E4\uC5D0\uC11C \uC190\uB2D8\uC744
    \uB300\uC811\uD560 \uB54C \uC120\uBCF4\uC774\uB294 \uC18C\uACE0\uAE30 \uC2A4\uD14C\uC774\uD06C.
    \uC694\uB9AC\uC5D0 \uB300\uD55C \uC790\uBD80\uC2EC\uC744 \uB2F4\uC544 \uC655\uC2E4\uC744
    \uB300\uD45C\uD558\uB294 \uC655\uAD00 \uBB38\uC591\uC744 \uC778\uB450\uB85C \uBC15\uC544
    \uB123\uC5C8\uB2E4. \uD06C\uAE30\uB3C4 \uD06C\uACE0 \uC721\uC999\uB3C4 \uAC00\uB4DD\uD574\uC11C
    \uACE0\uAE30\uB9CC \uBA39\uC5B4\uB3C4 \uBC30\uAC00 \uD130\uC9C8 \uB4EF \uBD80\uB974\uAC8C
    \uB41C\uB2E4."
